# Copy this file to .env for local development. Never commit .env.

# AI grading for FRQs: fill in ONE of these keys (or both).
# Without a key, FRQs use the free keyword-based rubric estimate.
#   Claude (paid per use):  https://console.anthropic.com
#   OpenAI (paid per use):  https://platform.openai.com/api-keys
#   Gemini (has a free tier): https://aistudio.google.com/apikey
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
# Optional: which Claude model to use. Leave blank for Claude Haiku 5.5, the cheapest
# good option (about $0.001 per FRQ grade). You can pick a model per job instead:
ANTHROPIC_MODEL=
ANTHROPIC_GRADER_MODEL=
ANTHROPIC_HELP_MODEL=
OPENAI_MODEL=gpt-5-mini
GEMINI_MODEL=gemini-flash-latest
# If several keys are set, Claude is used first, then OpenAI, then Gemini.
# Set AI_PROVIDER=openai or AI_PROVIDER=gemini to choose.
AI_PROVIDER=
# Spending caps (protect your API bill). Sized for about 1,000 students.
AI_MONTHLY_BUDGET_USD=100   # AI turns off for everyone until next month past this estimate
AI_DAILY_BUDGET_USD=        # blank = monthly budget / 15
AI_GRADES_PER_DAY=8         # each student, AI FRQ grades a day (re-grading the same answer is free)
AI_CHATS_PER_DAY=20         # each student, AI helper messages a day
AI_DAILY_LIMIT=8000         # backstop: all AI calls on the site in a day
GRADE_LIMIT_PER_HOUR=30     # each student, FRQ gradings per hour
HELP_LIMIT_PER_HOUR=60      # each student, AI helper messages per hour

# Secret used to sign login tokens. REQUIRED in production: use a long random string.
JWT_SECRET=change-me-to-a-long-random-string

# Database. Leave empty to use a local SQLite file at data/ap-study-path.db.
# For production use a hosted Postgres (Neon, Supabase, Render Postgres):
DATABASE_URL=

# Only needed if the frontend is hosted somewhere else (e.g. GitHub Pages):
# CORS_ORIGIN=https://mohanprabha9174-collab.github.io
PORT=3001

# Optional: email password-reset links (https://resend.com). Without these, students reset
# with the recovery code they get at sign-up, and the owner can make a link with:
#   npm run reset-link -- student@example.com
RESEND_API_KEY=
EMAIL_FROM=
APP_URL=
