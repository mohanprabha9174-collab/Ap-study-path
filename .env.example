# Copy this file to .env for local development. Never commit .env.

# Turns on AI grading for FRQs. Get a key at https://console.anthropic.com
# Without it, FRQs use the free keyword-based rubric estimate.
ANTHROPIC_API_KEY=
# Optional: which Claude model grades FRQs.
ANTHROPIC_MODEL=claude-sonnet-5-5
# Max AI gradings per student per hour (protects your API bill).
GRADE_LIMIT_PER_HOUR=30

# Secret used to sign login tokens. REQUIRED in production: use a long random string.
JWT_SECRET=change-me-to-a-long-random-string

# Database. Leave empty to use a local SQLite file at data/ap-study-path.db.
# For production use a hosted Postgres (Neon, Supabase, Render Postgres):
DATABASE_URL=

# Only needed if the frontend is hosted somewhere else (e.g. GitHub Pages):
# CORS_ORIGIN=https://mohanprabha9174-collab.github.io
PORT=3001
